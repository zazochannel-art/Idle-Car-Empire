# Optional: player accounts and cloud saves via Supabase. Leave empty to save in localStorage only.
# Apply supabase/migrations/0001-0003 and enable anonymous sign-ins: see docs/cloud-save.md.
# Both values are public (they ship inside the apps). Use the publishable/anon key,
# NEVER the service_role / sb_secret_ key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the AdMob rewarded ad units (docs/android/ads.md, docs/ios.md). Empty: Google's test ads.
NEXT_PUBLIC_ADMOB_REWARDED_ID=
NEXT_PUBLIC_ADMOB_REWARDED_ID_IOS=

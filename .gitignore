# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/e2e-results

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# Android signing (the upload key and its passwords stay on your computer / in CI secrets)
*.jks
*.keystore
keystore.properties
keystore.properties.txt
# a build's source maps (SOURCE_MAPS=1, scripts/build-app.mjs)
/source-maps

# The Android project lives in android/ and is tracked here (android.yml builds it); its own
# android/.gitignore keeps its build outputs, the game's copied files and the keys out.
# Android Studio's files when it opens this folder (open android/ instead):
/.gradle/
/.idea/
/.kotlin/
/local.properties
/build.gradle.kts
/settings.gradle.kts
/gradle.properties
/gradlew
/gradlew.bat
/gradle/

# the Supabase CLI's own files
supabase/.temp/
e2e/.*.local.mjs
